// tests/nextflow.config
params {
    // Local container repository on Hazel
    container_dir = "/usr/local/usrapps/brc/brc_modules/images"
    
    container__samtools = "${params.container_dir}/quay.io_biocontainers_samtools:1.24--h9dcdb79_1.sif"
    // ...one block per tool
}

process {
    withLabel: process_single { cpus = 1; memory = 2.GB }
    withLabel: process_low    { cpus = 2; memory = 4.GB }
    withLabel: process_medium { cpus = 2; memory = 6.GB }
    withLabel: process_high   { cpus = 4; memory = 8.GB }
}

apptainer {
    enabled = true
    autoMounts = true
}