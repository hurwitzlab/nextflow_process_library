// tests/nextflow.config
// Per-tool container images (params.container__<tool>): the Hazel defaults, generated by
// conf/make_containers.py. `run_tests.sh --all-versions` layers a per-version override on top.
includeConfig '../conf/containers_hazel.config'

process {
    // Every test task works on tiny data and finishes in seconds to a few minutes. Cap each one so a
    // hung tool (e.g. bbmerge's JVM after an assertion error) fails its own test instead of eating
    // the whole run_tests.sh job's wall time.
    time = 15.min

    withLabel: process_single { cpus = 1; memory = 2.GB }
    withLabel: process_low    { cpus = 2; memory = 4.GB }
    withLabel: process_medium { cpus = 2; memory = 6.GB }
    withLabel: process_high   { cpus = 4; memory = 8.GB }
}

apptainer {
    enabled = true
    autoMounts = true
}

// Tasks inherit the submitting shell's TMPDIR, which on Hazel often points at a host path the
// container doesn't mount (e.g. /share/brc/$USER/tmp): mafft, prokka (GNU parallel) and bbnorm then
// fail to create temp files. Use the container's own /tmp so tests don't depend on the user's env.
env {
    TMPDIR = '/tmp'
}
