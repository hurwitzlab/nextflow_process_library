// tests/nextflow.config
// Per-tool container images (params.container__<tool>): the Hazel defaults, generated by
// conf/make_containers.py. `run_tests.sh --all-versions` layers a per-version override on top.
includeConfig '../conf/containers_hazel.config'

process {
    withLabel: process_single { cpus = 1; memory = 2.GB }
    withLabel: process_low    { cpus = 2; memory = 4.GB }
    withLabel: process_medium { cpus = 2; memory = 6.GB }
    withLabel: process_high   { cpus = 4; memory = 8.GB }
}

apptainer {
    enabled = true
    autoMounts = true
}
