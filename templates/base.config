// ================================================================================
//                    TEMPLATE base.config FOR PIPELINES USING THIS LIBRARY
// ================================================================================
// Copy this file into your own pipeline (e.g. as conf/base.config) and
// `includeConfig` it from your pipeline's nextflow.config. Don't
// `includeConfig` it straight from this repo: the numbers below are a
// starting point, not tuned values, and your pipeline should own them.
//
// Every process in modules/ carries one resource label (process_single /
// process_low / process_medium / process_high) and, if it publishes output,
// one publish label (publish_final / publish_intermediate, or their
// *_pooled variants for all-samples-in-one-file outputs). Modules only
// apply these labels; this file is what gives them meaning.
//
// After a real run, check the trace/report files (or `seff <jobid>` per
// task on a SLURM cluster) and adjust the tiers to what your tools actually
// use. Hazel compute nodes come in 64 / 128 / 192 / 256 GB memory configs;
// cap requests per cluster with `resourceLimits` in that cluster's profile,
// not here.

// ================================================================================
//                    CENTRALIZED publishDir (label-based)
// ================================================================================
// A process publishes by carrying publish_final or publish_intermediate as
// its second label, with no publishDir directive of its own (see
// modules/CLAUDE.md). The withLabel: blocks at the bottom of this file give
// it a publishDir.
//
// Publish modes, overridable per run like any other param (e.g.
// `--publish_mode_intermediate copy`). 'symlink' points into the work
// directory: if that directory is removed (`cleanup = true`, or the 30-day
// scratch purge when work/ lives on /share), the published links break. Use
// 'copy' for anything you need to keep.
params.publish_mode_intermediate = 'symlink'
params.publish_mode_final        = 'copy'

// Where each process publishes: params.<process name>_outdir -- keyed by
// the PROCESS name, not the tool/file name. e.g. bbmap.nf's `pileup`
// publishes to params.pileup_outdir, not params.bbmap_outdir. Define one for
// every label-published process your pipeline uses, as either a plain path
// or a Closure taking sampleid:
//
//   params.pileup_outdir = "${params.outdir}/coverage"
//   params.pileup_outdir = { sid -> "${params.outdir}/${sid}/coverage" }
//
// task.process is fully qualified with its workflow path (e.g.
// "readqc:trimmomatic"), so this keeps only the part after the last ':'.

process {
    // Fallback for any process without a resource label.
    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    // Retry once, with every tier's request scaled by task.attempt, when a
    // task looks like it was killed for resources (exit 130-145, e.g. 137
    // out-of-memory / 140 time limit on SLURM, or 104). Any other failure
    // stops new tasks and lets running ones finish.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // ---------------- resource tiers ----------------
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    // ---------------- publishing ----------------
    // publish_final/publish_intermediate need `sampleid` in scope. Processes
    // that pool all samples into one output use the *_pooled labels below
    // (`pooledid` in scope); anything else uses an in-module publishDir
    // (see modules/CLAUDE.md).
    withLabel:publish_intermediate {
        publishDir = [
            path: { params.resolvePublishDir(task.process, sampleid) },
            mode: params.publish_mode_intermediate,
        ]
    }
    withLabel:publish_final {
        publishDir = [
            path: { params.resolvePublishDir(task.process, sampleid) },
            mode: params.publish_mode_final,
        ]
    }

    // Same as above, for processes whose output is ONE file for all samples
    // together (a cross-sample catalog, a final count table, ...). These take
    // `val(pooledid)` instead of `val(sampleid)`; a Closure-valued
    // params.<process>_outdir receives the pooledid.
    withLabel:publish_intermediate_pooled {
        publishDir = [
            path: { params.resolvePublishDir(task.process, pooledid) },
            mode: params.publish_mode_intermediate,
        ]
    }
    withLabel:publish_final_pooled {
        publishDir = [
            path: { params.resolvePublishDir(task.process, pooledid) },
            mode: params.publish_mode_final,
        ]
    }
}
