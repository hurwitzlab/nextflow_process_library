nextflow_process {
    name "Test mapped_reads_to_bam"
    script "../samtools.nf"
    process "mapped_reads_to_bam"
    tag "samtools"
    tag "mapped_reads_to_bam"

    test("Keeps only mapped reads") {
        when {
            process {
                """
                input[0] = [ 'test_mapped', file("${baseDir}/tests/data/alignments.sam") ]
                """
            }
        }
        then {
            assert process.success

            def (sampleid, bam_path) = process.out.mapped_bam[0]
            def reads = bam(bam_path).getSamLines()

            assert sampleid == 'test_mapped'
            assert bam_path.endsWith('test_mapped.mapped.bam')
            assert reads.size() == 400 // 420 records minus the 20 unmapped
            assert reads.every { ((it.split('\t')[1] as int) & 4) == 0 } // no unmapped flag
            // version-agnostic: the 11 mandatory SAM fields only (no header, no optional tags)
            assert snapshot(reads.collect { it.split('\t')[0..10].join('\t') }.join('\n').md5()).match()
        }
    }
}
