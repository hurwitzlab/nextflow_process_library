nextflow_process {
    name "Test to_bam"
    script "../samtools.nf"
    process "to_bam"
    tag "samtools"
    tag "to_bam"

    test("Converts a coordinate-sorted alignment file to an indexed BAM, keeping every record") {
        when {
            process {
                """
                input[0] = [ 'test_to_bam', file("${baseDir}/tests/data/alignments.sorted.bam") ]
                """
            }
        }
        then {
            assert process.success

            def (sampleid, bam_path) = process.out.bam_file[0]
            def (index_sampleid, bai_path) = process.out.bam_index[0]
            def reads = bam(bam_path).getSamLines()
            def fields = reads.collect { it.split('\t')[0..10].join('\t') }
            def expected = bam("${baseDir}/tests/data/alignments.sorted.bam").getSamLines()
                .collect { it.split('\t')[0..10].join('\t') }

            assert sampleid == 'test_to_bam'
            assert index_sampleid == 'test_to_bam'
            assert bam_path.endsWith('test_to_bam.bam')
            assert bai_path.endsWith('test_to_bam.bam.bai')
            assert path(bai_path).size() > 0
            assert reads.size() == 420 // unmapped reads are kept (no -F 4 here)
            assert fields == expected // already sorted: re-sorting leaves records and order unchanged
            // version-agnostic: the 11 mandatory SAM fields only (no header, no optional tags)
            assert snapshot(fields.join('\n').md5()).match()
        }
    }

    test("Sorts and indexes an unsorted SAM (bwa mem read order)") {
        when {
            process {
                """
                input[0] = [ 'test_to_bam_unsorted', file("${baseDir}/tests/data/alignments.sam") ]
                """
            }
        }
        then {
            assert process.success

            def (sampleid, bam_path) = process.out.bam_file[0]
            def (index_sampleid, bai_path) = process.out.bam_index[0]
            def reads = bam(bam_path).getSamLines()
            def fields = reads.collect { it.split('\t')[0..10].join('\t') }
            def positions = reads.findAll { ((it.split('\t')[1] as int) & 4) == 0 }
                                 .collect { it.split('\t')[3] as int }
            def expected = bam("${baseDir}/tests/data/alignments.sorted.bam").getSamLines()
                .collect { it.split('\t')[0..10].join('\t') }

            assert sampleid == 'test_to_bam_unsorted'
            assert index_sampleid == 'test_to_bam_unsorted'
            assert bam_path.endsWith('test_to_bam_unsorted.bam')
            assert bai_path.endsWith('test_to_bam_unsorted.bam.bai')
            assert path(bai_path).size() > 0
            assert reads.size() == 420 // unmapped reads are kept (no -F 4 here)
            assert positions == positions.sort(false) // coordinate order
            assert fields == expected // same records and order as the shared sorted fixture
        }
    }
}
