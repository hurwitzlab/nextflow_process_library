nextflow_process {
    name "Test collect_insert_size_metrics"
    script "../picard.nf"
    process "collect_insert_size_metrics"
    tag "picard"
    tag "collect_insert_size_metrics"

    test("Collects insert size metrics and a histogram") {
        when {
            process {
                """
                input[0] = [ 'test_insert_size',
                             file("${baseDir}/tests/data/alignments.sorted.bam"),
                                 file("${baseDir}/tests/data/alignments.sorted.bam.bai") ]
                """
            }
        }
        then {
            assert process.success

            // Picard metrics files start with '#' lines (command line, date), then a tab-separated
            // header + rows; read rows as maps keyed by column name rather than snapshotting the file
            def metricRows = { p ->
                def lines = path(p).readLines().dropWhile { !it || it.startsWith('#') }
                def header = lines[0].split('\t')
                // the metrics table ends at the first blank line (a histogram section may follow)
                lines.drop(1).takeWhile { it }
                     .collect { [header, it.split('\t', -1)].transpose().collectEntries() }
            }
            def (sampleid, txt) = process.out.insert_size_metrics[0]
            def (sampleid2, pdf) = process.out.insert_size_histogram[0]
            def m = metricRows(txt)[0]

            assert sampleid == 'test_insert_size' && sampleid2 == sampleid
            assert m.READ_PAIRS == '200'
            assert m.PAIR_ORIENTATION == 'FR'
            // simulated inserts are 60-400 bp
            assert (m.MIN_INSERT_SIZE as int) >= 60 && (m.MAX_INSERT_SIZE as int) <= 400
            // the module touches the PDF first, so check it was really written (needs R in the image)
            assert path(pdf).toFile().length() > 0
        }
    }
}
