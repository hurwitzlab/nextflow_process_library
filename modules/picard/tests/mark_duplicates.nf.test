nextflow_process {
    name "Test mark_duplicates"
    script "../picard.nf"
    process "mark_duplicates"
    tag "picard"
    tag "mark_duplicates"

    test("Marks duplicates in a coordinate-sorted BAM") {
        when {
            process {
                """
                input[0] = [ 'test_mark_duplicates',
                             file("${baseDir}/tests/data/alignments.sorted.bam"),
                                 file("${baseDir}/tests/data/alignments.sorted.bam.bai") ]
                """
            }
        }
        then {
            assert process.success

            // Picard metrics files start with '#' lines (command line, date), then a tab-separated
            // header + rows; read rows as maps keyed by column name rather than snapshotting the file
            def metricRows = { p ->
                def lines = path(p).readLines().dropWhile { !it || it.startsWith('#') }
                def header = lines[0].split('\t')
                // the metrics table ends at the first blank line (a histogram section may follow)
                lines.drop(1).takeWhile { it }
                     .collect { [header, it.split('\t', -1)].transpose().collectEntries() }
            }
            def (sampleid, bam_path) = process.out.dupmarked_bam[0]
            def (sampleid2, txt) = process.out.duplicate_metrics[0]
            def m = metricRows(txt)[0]

            assert sampleid == 'test_mark_duplicates' && sampleid2 == sampleid
            assert bam_path.endsWith('test_mark_duplicates.markdup.bam')
            assert bam(bam_path).getSamLines().size() == 420 // marks, never drops
            assert m.READ_PAIRS_EXAMINED == '200'
            assert m.UNMAPPED_READS == '20'
            assert m.READ_PAIR_DUPLICATES == '0'
        }
    }
}
