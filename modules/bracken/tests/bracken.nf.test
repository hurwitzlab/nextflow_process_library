nextflow_process {
    name "Test bracken"
    script "../bracken.nf"
    process "bracken"
    tag "bracken"

    test("Re-estimates species abundance from a kraken2 report") {
        setup {
            run("kraken2") {
                script "../../kraken2/kraken2.nf"
                process {
                    """
                    input[0] = [ 'test_bracken',
                                 file("${baseDir}/tests/data/reads_R1.fastq.gz"),
                                 file("${baseDir}/tests/data/reads_R2.fastq.gz") ]
                    input[1] = file("${baseDir}/tests/data/kraken2_db")
                    """
                }
            }
        }
        when {
            params {
                bracken_readlen = 100
            }
            process {
                """
                input[0] = kraken2.out.classification.map { sampleid, kreport, kraken -> [ sampleid, kreport ] }
                input[1] = file("${baseDir}/tests/data/kraken2_db")
                """
            }
        }
        then {
            assert process.success

            def (sampleid, table) = process.out.abundance_table[0]
            def lines = path(table).readLines()

            assert sampleid == 'test_bracken'
            assert table.endsWith('test_bracken.bracken')
            assert lines[0] == 'name\ttaxonomy_id\ttaxonomy_lvl\tkraken_assigned_reads\tadded_reads\tnew_est_reads\tfraction_total_reads'
            // one species in the db, so nothing to redistribute: all 200 classified pairs stay on phiX174
            assert lines.drop(1) == ['Escherichia virus phiX174\t10847\tS\t200\t0\t200\t1.00000']
            assert snapshot(path(table)).match()
        }
    }

    test("Fails with the cause when the db has no kmer_distrib for the read length") {
        setup {
            run("kraken2") {
                script "../../kraken2/kraken2.nf"
                process {
                    """
                    input[0] = [ 'test_bracken_150',
                                 file("${baseDir}/tests/data/reads_R1.fastq.gz"),
                                 file("${baseDir}/tests/data/reads_R2.fastq.gz") ]
                    input[1] = file("${baseDir}/tests/data/kraken2_db")
                    """
                }
            }
        }
        when {
            params {
                bracken_readlen = 150 // the fixture db only has database100mers.kmer_distrib
            }
            process {
                """
                input[0] = kraken2.out.classification.map { sampleid, kreport, kraken -> [ sampleid, kreport ] }
                input[1] = file("${baseDir}/tests/data/kraken2_db")
                """
            }
        }
        then {
            // bracken itself exits 0 here (its ERROR goes to stdout); the module's own check turns that
            // into a failure, with the cause on stderr instead of a bare "Missing output file(s)"
            assert process.failed
            assert process.errorReport.contains('bracken produced no output; it needs')
            assert process.errorReport.contains('database150mers.kmer_distrib')
        }
    }
}
