nextflow_process {
    name "Test ont_read_accuracy"
    script "../minimap2.nf"
    process "ont_read_accuracy"
    tag "minimap2"
    tag "ont_read_accuracy"

    test("Estimates per-read and mean identity of ONT reads") {
        when {
            params {
                ont_read_accuracy_outdir = "$outputDir"
            }
            process {
                """
                input[0] = [ 'test_acc', file("${baseDir}/tests/data/long_reads.fastq.gz") ]
                input[1] = file("${baseDir}/tests/data/genome.fasta")
                """
            }
        }
        then {
            assert process.success

            def (table_id, table_path) = process.out.read_accuracy_table[0]
            def (mean_id, mean_path) = process.out.mean_accuracy[0]
            def table = path(table_path).readLines()
            def rows = table.drop(1).collect { it.split('\t') }
            def identities = rows.collect { it[2] as double }
            def mean = path(mean_path).text.trim() as double

            assert table_id == 'test_acc'
            assert mean_id == 'test_acc'
            assert table_path.endsWith('test_acc.read_accuracy.tsv')
            assert mean_path.endsWith('test_acc.accuracy.txt')
            assert table[0] == 'name\tlength\tidentity'
            assert rows.size() == 30 // exactly one row per read
            assert rows.collect { it[0] }.toSet().size() == 30
            // reads were simulated at ~91% accuracy (~5% substitutions + ~4% indels)
            assert identities.every { it > 0.85 && it < 0.95 }
            assert mean > 0.85 && mean < 0.95
            assert Math.abs(mean - identities.sum() / identities.size()) < 1e-4
            assert snapshot(path(table_path), path(mean_path)).match()
        }
    }

    test("Scores a split read once, summed over its pieces, even when its name sorts after the contig") {
        when {
            params {
                ont_read_accuracy_outdir = "$outputDir"
            }
            process {
                """
                input[0] = [ 'test_chim', file("${baseDir}/modules/minimap2/tests/testdata/chimeric_read.fastq") ]
                input[1] = file("${baseDir}/tests/data/genome.fasta")
                """
            }
        }
        then {
            assert process.success

            def (table_id, table_path) = process.out.read_accuracy_table[0]
            def (mean_id, mean_path) = process.out.mean_accuracy[0]

            // zz_chimera aligns as two pieces (1000/1000 + 960/1000 matches), see testdata/README.md;
            // the old ava-ont preset dropped it entirely because "zz_chimera" > "phiX174"
            assert path(table_path).readLines() == ['name\tlength\tidentity', 'zz_chimera\t2000\t0.98']
            assert path(mean_path).text.trim() == '0.98'
        }
    }
}
