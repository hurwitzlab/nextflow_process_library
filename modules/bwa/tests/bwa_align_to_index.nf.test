nextflow_process {
    name "Test bwa_align_to_index"
    script "../bwa.nf"
    process "bwa_align_to_index"
    tag "bwa"
    tag "bwa_align_to_index"

    test("Aligns paired-end reads to a bwa index packaged as a tarball") {
        when {
            process {
                """
                input[0] = file("${baseDir}/modules/bwa/tests/testdata/ref_index.tar.gz")
                input[1] = [ 'test_bwa_tar',
                             file("${baseDir}/tests/data/reads_R1.fastq.gz"),
                             file("${baseDir}/tests/data/reads_R2.fastq.gz") ]
                """
            }
        }
        then {
            assert process.success

            def (sampleid, sam_path) = process.out.sam_file[0]
            def fields = { p -> path(p).readLines().findAll { !it.startsWith('@') }
                                .collect { it.split('\t')[0..10].join('\t') } }
            def records = fields(sam_path)

            assert sampleid == 'test_bwa_tar'
            assert sam_path.endsWith('test_bwa_tar.sam')
            assert path(sam_path).readLines().any { it.startsWith('@SQ\tSN:phiX174\tLN:5386') }
            assert records.size() == 420
            assert records.count { ((it.split('\t')[1] as int) & 4) != 0 } == 20 // the 10 random pairs
            // same reads, same aligner: matches the shared fixture built with bwa mem
            assert records == fields("${baseDir}/tests/data/alignments.sam")
            // version-agnostic: the 11 mandatory SAM fields only (no header, no optional tags)
            assert snapshot(records.join('\n').md5()).match()
        }
    }

    test("Fails when the tarball holds ref.fa but no bwa index") {
        when {
            process {
                """
                input[0] = file("${baseDir}/modules/minimap2/tests/testdata/ref.tar.gz")
                input[1] = [ 'test_bwa_tar_no_index',
                             file("${baseDir}/tests/data/reads_R1.fastq.gz"),
                             file("${baseDir}/tests/data/reads_R2.fastq.gz") ]
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('fail to locate the index files') // bwa mem's own error
        }
    }

    test("Fails with a clear message when ref.fa isn't at the tarball's top level") {
        when {
            process {
                """
                input[0] = file("${baseDir}/modules/bwa/tests/testdata/nested_ref.tar.gz")
                input[1] = [ 'test_bwa_tar_nested',
                             file("${baseDir}/tests/data/reads_R1.fastq.gz"),
                             file("${baseDir}/tests/data/reads_R2.fastq.gz") ]
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains('nested_ref.tar.gz has no ref.fa at its top level')
        }
    }
}
