nextflow_process {
    name "Test bwa_mem"
    script "../bwa.nf"
    process "bwa_mem"
    tag "bwa"
    tag "bwa_mem"

    test("Aligns paired-end reads to the output of bwa_index") {
        setup {
            run("bwa_index") {
                script "../bwa.nf"
                process {
                    """
                    input[0] = file("${baseDir}/tests/data/genome.fasta")
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = Channel.of([ 'test_bwa_mem',
                                        file("${baseDir}/tests/data/reads_R1.fastq.gz"),
                                        file("${baseDir}/tests/data/reads_R2.fastq.gz") ])
                               .combine(bwa_index.out.indexed_sequence)
                """
            }
        }
        then {
            assert process.success

            def (sampleid, sam_path) = process.out.sam_file[0]
            def fields = { p -> path(p).readLines().findAll { !it.startsWith('@') }
                                .collect { it.split('\t')[0..10].join('\t') } }
            def records = fields(sam_path)

            assert sampleid == 'test_bwa_mem'
            assert sam_path.endsWith('test_bwa_mem.sam')
            assert path(sam_path).readLines().any { it.startsWith('@SQ\tSN:phiX174\tLN:5386') }
            assert records.size() == 420
            assert records.count { ((it.split('\t')[1] as int) & 4) != 0 } == 20 // the 10 random pairs
            // same reads, same aligner: matches the shared fixture built with bwa mem
            assert records == fields("${baseDir}/tests/data/alignments.sam")
            // version-agnostic: the 11 mandatory SAM fields only (no header, no optional tags)
            assert snapshot(records.join('\n').md5()).match()
        }
    }
}
