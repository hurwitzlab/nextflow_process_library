nextflow_process {
    name "Test bwa_index"
    script "../bwa.nf"
    process "bwa_index"
    tag "bwa"
    tag "bwa_index"

    test("Indexes a reference FASTA") {
        when {
            process {
                """
                input[0] = file("${baseDir}/tests/data/genome.fasta")
                """
            }
        }
        then {
            assert process.success

            def (reference, index_files) = process.out.indexed_sequence[0]

            assert file(reference).name == 'genome.fasta'
            assert path(reference).text == path("${baseDir}/tests/data/genome.fasta").text
            assert index_files.collect { file(it).name }.sort() ==
                ['amb', 'ann', 'bwt', 'pac', 'sa'].collect { "genome.fasta.${it}".toString() }
            // .ann/.amb are plain text (sequence names, lengths, ambiguous-base runs); the binary
            // .bwt/.pac/.sa are only checked by bwa_mem.nf.test, which aligns against them
            assert snapshot(index_files.findAll { it ==~ /.*\.(ann|amb)$/ }.sort().collect { path(it).text }).match()
        }
    }
}
