nextflow_process {
    name "Test bwa_index"
    script "../bwa.nf"
    process "bwa_index"
    tag "bwa"
    tag "bwa_index"

    test("Indexes a reference FASTA") {
        when {
            process {
                """
                input[0] = file("${baseDir}/tests/data/genome.fasta")
                """
            }
        }
        then {
            assert process.success

            def indexed = process.out.indexed_sequence[0]

            assert file(indexed).name == 'genome.fasta'
            assert path(indexed).text == path("${baseDir}/tests/data/genome.fasta").text // passed through unchanged
            // TODO(module bug): bwa_index declares only `path("${sequence_to_map}")` as output, so the
            // index files bwa writes (genome.fasta.{amb,ann,bwt,pac,sa}) are never emitted and a
            // downstream bwa_mem gets a bare FASTA. Once the output also captures them, assert that all
            // five are emitted with those names, and snapshot genome.fasta.ann / .amb (plain text).
        }
    }
}
